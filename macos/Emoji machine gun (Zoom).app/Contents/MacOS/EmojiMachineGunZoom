#!/bin/bash
set -euo pipefail

APP_EXEC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_BUNDLE_DIR="$(cd "${APP_EXEC_DIR}/../.." && pwd)"
SOURCE_DIR="$(cd "${APP_BUNDLE_DIR}/.." && pwd)"
BOOTSTRAP="${SOURCE_DIR}/bootstrap.sh"

if [ ! -f "${BOOTSTRAP}" ]; then
  osascript -e 'display dialog "Cannot find macOS bootstrap.sh next to the app bundle." with title "Emoji machine gun for Zoom" buttons {"Quit"} default button "Quit" with icon stop'
  exit 1
fi

exec /bin/bash "${BOOTSTRAP}"
